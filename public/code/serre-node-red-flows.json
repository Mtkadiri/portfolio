p = { value: p };\n\n// --- Commande reçue depuis Régulation : on mémorise l'état, pas de ligne écrite ---\nif (p.temperature === undefined) {\n    const name = String(p.actuator || p.actionneur || p.device || p.name || p.target || msg.topic || \"\").toLowerCase();\n    const val = [p.state, p.etat, p.value, p.cmd, p.command, p.action].find(x => x !== undefined);\n\n    if (p.ventilation !== undefined) flow.set(\"csv_vent\", norm(p.ventilation));\n    if (p.irrigation !== undefined) flow.set(\"csv_irrig\", norm(p.irrigation));\n    if (val !== undefined && name.includes(\"vent\")) flow.set(\"csv_vent\", norm(val));\n    if (val !== undefined && name.includes(\"irrig\")) flow.set(\"csv_irrig\", norm(val));\n\n    return null;\n}\n\n// --- Mesure : on écrit une ligne avec les derniers états de Régulation ---\nconst vent = flow.get(\"csv_vent\") || \"OFF\";\nconst irrig = flow.get(\"csv_irrig\") || \"OFF\";\nconst ts = String(p.ts);\nconst date = ts.slice(0, 10);    // 2026-10-29\nconst heure = ts.slice(11, 19);  // 17:36:06\n\nnode.status({ fill: \"green\", shape: \"dot\", text: \"seq \" + p.seq + \" | V:\" + vent + \" I:\" + irrig });\n\nreturn {\n    payload: [date, heure, p.seq, p.device_id, p.temperature, p.humidity, p.soil_moisture, p.illuminance, vent, irrig].join(\",\")\n};","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":1240,"y":1460,"wires":[["1544fc9cedb23927"]]},{"id":"1544fc9cedb23927","type":"file","z":"aa0c292904c479b4","name":"CSV mesures (ajoute)","filename":"C:/Users/kadka/Documents/serre_mesures.csv","filenameType":"str","appendNewline":true,"createDir":true,"overwriteFile":"false","encoding":"utf8","x":1480,"y":1460,"wires":[[]]},{"id":"a751ca6c7140b9da","type":"http in","z":"aa0c292904c479b4","name":"GET /serre.csv","url":"/serre.csv","method":"get","upload":false,"swaggerDoc":"","x":1240,"y":1540,"wires":[["0e56d28c2ad0ba9c"]]},{"id":"0e56d28c2ad0ba9c","type":"file in","z":"aa0c292904c479b4","name":"Lire le CSV","fil