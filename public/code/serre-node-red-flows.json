[{"id":"aa0c292904c479b4","type":"tab","label":"Flow 1","disabled":false,"info":"","env":[]},{"id":"a496d4a9385aa8ed","type":"function","z":"aa0c292904c479b4","name":"Simulateur","func":"const r = (min, max, d = 1) => +(min + Math.random() * (max - min)).toFixed(d);\nlet seq = (context.get(\"seq\") || 0) + 1;\ncontext.set(\"seq\", seq);\n\nmsg.payload = {\n    device_id: \"serre-01\",\n    ts: new Date().toISOString(),\n    seq: seq,\n    temperature: r(10, 45),\n    humidity: r(20, 95),\n    soil_moisture: r(5, 95),\n    illuminance: r(0, 60000, 0)\n};\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":630,"y":620,"wires":[["0f2a4fa67e985bec","355c6ac5b7294294"]]},{"id":"51d7cc54f097971b","type":"inject","z":"aa0c292904c479b4","name":"","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"3","crontab":"","once":true,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":430,"y":620,"wires":[["a496d4a9385aa8ed"]]},{"id":"0f2a4fa67e985bec","type":"debug","z":"aa0c292904c479b4","name":"debug 1","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"false","statusVal":"","statusType":"auto","x":820,"y":720,"wires":[]},{"id":"355c6ac5b7294294","type":"mqtt out","z":"aa0c292904c479b4","name":"","topic":"tp/kadiri/serre/telemetry","qos":"0","retain":"false","respTopic":"","contentType":"","userProps":"","correl":"","expiry":"","broker":"20c83876a8ac9599","x":890,"y":620,"wires":[]},{"id":"916cc63e1b31c15e","type":"mqtt in","z":"aa0c292904c479b4","name":"","topic":"tp/kadiri/serre/telemetry","qos":"0","datatype":"json","broker":"20c83876a8ac9599","nl":false,"rap":true,"rh":0,"inputs":0,"x":400,"y":820,"wires":[["72a324032c838f21"]]},{"id":"777315f1b50bb74c","type":"debug","z":"aa0c292904c479b4","name":"Mesure valide","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"payload","targetType":"msg","statusVal":"","statusType":"auto","x":840,"y":840,"wires":[]},{"id":"72a324032c838f21","type":"function","z":"aa0c292904c479b4","name":"Validation","func":"const p = msg.payload;\n\nconst plages = {\n    temperature:   [10, 45],\n    humidity:      [20, 95],\n    soil_moisture: [5, 95],\n    illuminance:   [0, 60000]\n};\n\nlet erreurs = [];\n\nif (typeof p !== \"object\" || p === null) {\n    erreurs.push(\"payload n'est pas un objet\");\n} else {\n    for (const champ in plages) {\n        const v = p[champ];\n        const [min, max] = plages[champ];\n        if (typeof v !== \"number\" || isNaN(v)) {\n            erreurs.push(champ + \" absent ou non numérique\");\n        } else if (v < min || v > max) {\n            erreurs.push(champ + \" hors plage (\" + v + \")\");\n        }\n    }\n}\n\nif (erreurs.length === 0) {\n    return [msg, null];\n} else {\n    msg.erreurs = erreurs;\n    return [null, msg];\n}","outputs":2,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":660,"y":940,"wires":[["777315f1b50bb74c","146776b9d5f55010","a7afdf52de7b7a95","bd8d711c98d047f4"],["3731f708f6d5f27b"]]},{"id":"b17523fc08cc0f50","type":"inject","z":"aa0c292904c479b4","name":"","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"{\"device_id\":\"serre-01\",\"temperature\":80,\"humidity\":50,\"soil_moisture\":40,\"illuminance\":1000}","payloadType":"json","x":370,"y":1040,"wires":[["72a324032c838f21"]]},{"id":"3731f708f6d5f27b","type":"debug","z":"aa0c292904c479b4","name":"Mesure rejetée","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"erreurs","targetType":"msg","statusVal":"","statusType":"auto","x":900,"y":1020,"wires":[]},{"id":"146776b9d5f55010","type":"function","z":"aa0c292904c479b4","name":"Régulation","func":"const mode = context.get(\"mode\") || \"AUTO\";\n\n// états précédents (mémorisés entre deux messages)\nlet vent = context.get(\"vent\") || \"OFF\";\nlet irrig = context.get(\"irrig\") || \"OFF\";\nconst dev = context.get(\"device_id\") || \"serre-01\";\n\n// --- Interrupteur Mode : ON = Manuel, OFF = Auto ---\nif (msg.topic === \"mode\") {\n    const nouveau = (msg.payload === true) ? \"MANUEL\" : \"AUTO\";\n    context.set(\"mode\", nouveau);\n    node.status({ fill: nouveau === \"AUTO\" ? \"green\" : \"yellow\", shape: \"dot\", text: \"Mode \" + nouveau });\n    return null;\n}\n\n// --- Boutons manuels (actifs seulement en mode Manuel) ---\nif (msg.topic === \"vent_btn\" || msg.topic === \"irrig_btn\") {\n    if (mode !== \"MANUEL\") {\n        node.status({ fill: \"red\", shape: \"ring\", text: \"Bouton ignoré (mode AUTO)\" });\n        return null;\n    }\n    const state = (msg.payload === true) ? \"ON\" : \"OFF\";\n    const ts = new Date().toISOString();\n\n    if (msg.topic === \"vent_btn\") {\n        context.set(\"vent\", state);\n        return [{ payload: { device_id: dev, actuator: \"ventilation\", state: state, ts: ts } }, null];\n    } else {\n        context.set(\"irrig\", state);\n        return [null, { payload: { device_id: dev, actuator: \"irrigation\", state: state, ts: ts } }];\n    }\n}\n\n// --- Télémétrie : régulation automatique ---\nconst m = msg.payload;\nif (!m || typeof m !== \"object\") return null;\n\nif (m.device_id) context.set(\"device_id\", m.device_id);\n\n// En mode Manuel, on ne régule pas\nif (mode !== \"AUTO\") return null;\n\n// Ventilation : ON si T >= 30, OFF si T <= 28\nif (m.temperature >= 30) vent = \"ON\";\nelse if (m.temperature <= 28) vent = \"OFF\";\n\n// Irrigation : ON si sol <= 35, OFF si sol >= 60\nif (m.soil_moisture <= 35) irrig = \"ON\";\nelse if (m.soil_moisture >= 60) irrig = \"OFF\";\n\ncontext.set(\"vent\", vent);\ncontext.set(\"irrig\", irrig);\n\nnode.status({ fill: \"green\", shape: \"dot\", text: \"AUTO | V:\" + vent + \" I:\" + irrig });\n\n// Commande ventilation et irrigation\nreturn [\n    { payload: { device_id: m.device_id, actuator: \"ventilation\", state: vent, ts: m.ts } },\n    { payload: { device_id: m.device_id, actuator: \"irrigation\", state: irrig, ts: m.ts } }\n];","outputs":2,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":1090,"y":860,"wires":[["3ec45e83d1b32f8f","3f0a3d3259b98f4c","b0059ddd7a64947a","bd8d711c98d047f4"],["3ec45e83d1b32f8f","3f0a3d3259b98f4c","fb3252142d6dd66e","bd8d711c98d047f4"]]},{"id":"3ec45e83d1b32f8f","type":"mqtt out","z":"aa0c292904c479b4","name":"","topic":"tp/kadiri/serre/cmd","qos":"0","retain":"false","respTopic":"","contentType":"","userProps":"","correl":"","expiry":"","broker":"20c83876a8ac9599","x":1310,"y":840,"wires":[]},{"id":"3f0a3d3259b98f4c","type":"debug","z":"aa0c292904c479b4","name":"Commandes","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"payload","targetType":"msg","statusVal":"","statusType":"auto","x":1330,"y":960,"wires":[]},{"id":"86bc3550391f70b7","type":"inject","z":"aa0c292904c479b4","name":"","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"{\"device_id\":\"serre-01\",\"temperature\":32,\"humidity\":50,\"soil_moisture\":30,\"illuminance\":1000}","payloadType":"json","x":870,"y":940,"wires":[["146776b9d5f55010"]]},{"id":"a9cf115f12abc26b","type":"ui-gauge","z":"aa0c292904c479b4","name":"Température","group":"275fcd1ae16268c2","order":2,"value":"payload","valueType":"msg","width":3,"height":3,"gtype":"gauge-half","gstyle":"needle","title":"Température","alwaysShowTitle":false,"floatingTitlePosition":"top-left","units":"°C","icon":"","prefix":"","suffix":"","segments":[{"from":"0","color":"#5cd65c","text":"","textType":"label"},{"from":"4","color":"#ffc800","text":"","textType":"label"},{"from":"7","color":"#ea5353","text":"","textType":"label"}],"min":"10","max":"45","sizeThickness":16,"sizeGap":4,"sizeKeyThickness":8,"styleRounded":true,"styleGlow":false,"className":"","x":910,"y":1060,"wires":[[]]},{"id":"69445385cee8111b","type":"ui-gauge","z":"aa0c292904c479b4","name":"Humidité","g